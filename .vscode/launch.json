{
  // F5로 실행, Shift+F5로 종료. 왼쪽 "실행 및 디버그" 창 위쪽에서 둘 중 하나를 고른다.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "앱 실행",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      // 코드를 저장하면 앱이 자동으로 다시 뜬다(gradio 자동 재시작). 화면 작업(#22, #23, #37)에 편하다.
      // 끌 때는 터미널에서 Ctrl+C를 권한다. 남은 프로세스가 포트를 잡으면 다음 실행이 7861 같은 다른 포트로 뜬다.
      "name": "앱 실행 (저장하면 자동 재시작)",
      "type": "debugpy",
      "request": "launch",
      "module": "gradio",
      "args": ["app.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONIOENCODING": "utf-8" }
    }
  ]
}
